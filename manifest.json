{
  "manifest_version": 3,
  "name": "ScraperPro - Web Scraper & Tracker",
  "version": "2.0.0",
  "description": "Scrape any website, export to Google Sheets, track prices, AI-powered selectors. No coding needed.",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "alarms",
    "identity",
    "notifications"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],

  "oauth2": {
    "client_id": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "ScraperPro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}